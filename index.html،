  src.value = tgt.value;
  tgt.value = tmp;
  
  direction = (direction === 'ar2lat') ? 'lat2ar' : 'ar2lat';
  
  const labels = document.querySelectorAll('.lang-label span');
  if (direction === 'ar2lat') {
    labels[0].textContent = '🇹🇳 اللهجة التونسية (عربي)';
    labels[1].textContent = '🔤 العربيزي (Latin)';
  } else {
    labels[0].textContent = '🔤 العربيزي (Latin)';
    labels[1].textContent = '🇹🇳 اللهجة التونسية (عربي)';
  }
  
  setStatus('🔄 تم عكس الاتجاه', 'success');
}

function setStatus(msg, cls) {
  const s = document.getElementById('status');
  s.textContent = msg;
  s.className = 'status ' + (cls || '');
  if (cls === 'success') {
    clearTimeout(window._statusTimer);
    window._statusTimer = setTimeout(() => {
      s.textContent = '';
      s.className = 'status';
    }, 3000);
  }
}

