/* حروف وأرقام العربيزي الفردية */
const charMap = {
  'ش': 'ch', 'خ': 'kh', 'غ': 'gh', 'ح': '7', 'ع': '3', 'ق': '9',
  'ة': 'a', 'ى': 'a', 'أ': 'a', 'إ': 'e', 'آ': 'a', 'ئ': 'e', 'ؤ': 'ou',
  'ث': 'th', 'ذ': 'dh', 'ض': 'dh', 'ظ': 'dh', 'ص': 's', 'ط': 't',
