  'ك': 'k', 'ه': 'h', 'ج': 'j', 'ا': 'a', 'ء': ''
};

/* بناء قاموس عكسي (عربيزي → تونسي) */
const reverseDictionary = {};
dictionary.forEach(([ar, lat]) => {
  const key = lat.toLowerCase().trim();
  if (!reverseDictionary[key]) reverseDictionary[key] = ar;
});

/* حالة الاتجاه */
let direction = 'ar2lat'; // ar2lat أو lat2ar

/* دالة الترجمة الرئيسية */
function translateText() {
  const src = document.getElementById('srcText').value.trim();
  const tgt = document.getElementById('tgtText');
  const status = document.getElementById('status');
  
  if (!src) {
    setStatus('⚠️ الرجاء إدخال نص للترجمة', 'error');
    return;
  }
  
  try {
    let result = (direction === 'ar2lat') 
      ? translateArabicToLatin(src) 
      : translateLatinToArabic(src);
    
    tgt.value = result;
    setStatus('✅ تمت الترجمة بنجاح', 'success');
  } catch (e) {
    setStatus('❌ حدث خطأ في الترجمة', 'error');
    console.error(e);
  }
}

/* عربي تونسي → عربيزي */
function translateArabicToLatin(text) {
  let result = text;
  
  // 1. استبدال العبارات الكاملة أولاً (الأطول أولاً)
  const sortedDict = [...dictionary].sort((a, b) => b[0].length - a[0].length);
  sortedDict.forEach(([ar, lat]) => {
    const regex = new RegExp(escapeRegex(ar), 'g');
    result = result.replace(regex, lat);
  });
  
  // 2. استبدال الحروف المتبقية
  let out = '';
  for (const ch of result) {
    if (charMap[ch] !== undefined) {
      out += charMap[ch];
    } else {
      out += ch;
    }
  }
  
  // 3. تنظيف المسافات
  return out.replace(/\s+/g, ' ').trim();
}

/* عربيزي → عربي تونسي */
function translateLatinToArabic(text) {
  let result = text;
  
  // 1. استبدال الكلمات الكاملة (الأطول أولاً)
  const sortedReverse = Object.keys(reverseDictionary).sort((a, b) => b.length - a.length);
  sortedReverse.forEach(lat => {
    const regex = new RegExp('\\b' + escapeRegex(lat) + '\\b', 'gi');
    result = result.replace(regex, reverseDictionary[lat]);
  });
  
  // 2. استبدال الأرقام العربية المتعارف عليها
  const numMap = {
    '7': 'ح', '3': 'ع', '9': 'ق', '2': 'ء', '5': 'خ', '6': 'ط'
  };
  Object.keys(numMap).forEach(num => {
    result = result.replace(new RegExp(num, 'g'), numMap[num]);
  });
  
  // 3. استبدال تراكيب الحروف اللاتينية
  const comboMap = [
    ['ch', 'ش'], ['kh', 'خ'], ['gh', 'غ'], ['th', 'ث'], ['dh', 'ذ'],
    ['ou', 'و'], ['sh', 'ش'], ['aa', 'ا'], ['ee', 'ي'], ['oo', 'و']
  ];
  comboMap.forEach(([lat, ar]) => {
    result = result.replace(new RegExp(lat, 'gi'), ar);
  });
  
  // 4. الحروف المفردة
  const singleMap = {
    'a': 'ا', 'b': 'ب', 'c': 'ك', 'd': 'د', 'e': 'ي', 'f': 'ف',
    'g': 'ق', 'h': 'ه', 'i': 'ي', 'j': 'ج', 'k': 'ك', 'l': 'ل',
    'm': 'م', 'n': 'ن', 'o': 'و', 'p': 'ب', 'q': 'ق', 'r': 'ر',
    's': 'س', 't': 'ت', 'u': 'و', 'v': 'ف', 'w': 'و', 'x': 'كس',
    'y': 'ي', 'z': 'ز'
  };
  let out = '';
  for (const ch of result) {
    const lower = ch.toLowerCase();
    if (singleMap[lower] !== undefined && /[a-zA-Z]/.test(ch)) {
      out += singleMap[lower];
    } else {
      out += ch;
    }
  }
  
  return out.replace(/\s+/g, ' ').trim();
}

function escapeRegex(str) {
  return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

/* ============ النطق الصوتي ============ */
function speakText(id) {
  const text = document.getElementById(id).value.trim();
  if (!text) {
    setStatus('⚠️ لا يوجد نص للنطق', 'error');
    return;
  }
  
  if (!('speechSynthesis' in window)) {
    setStatus('❌ متصفحك لا يدعم النطق الصوتي', 'error');
    return;
  }
  
  window.speechSynthesis.cancel();
  
  const utter = new SpeechSynthesisUtterance(text);
  
  // تحديد اللغة حسب المحتوى
  const isArabic = /[\u0600-\u06FF]/.test(text);
  utter.lang = isArabic ? 'ar-TN' : 'fr-FR';
  utter.rate = 0.9;
  utter.pitch = 1;
  
  // محاولة اختيار صوت مناسب
  const voices = window.speechSynthesis.getVoices();
  const preferred = voices.find(v => v.lang.startsWith(isArabic ? 'ar' : 'fr'));
  if (preferred) utter.voice = preferred;
  
  utter.onstart = () => setStatus('🔊 جاري النطق...', 'success');
  utter.onend = () => setStatus('✅ انتهى النطق', 'success');
  utter.onerror = (e) => setStatus('❌ خطأ في النطق', 'error');
  
  window.speechSynthesis.speak(utter);
}

/* تحميل الأصوات */
if ('speechSynthesis' in window) {
  window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
